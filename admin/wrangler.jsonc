// admin.jason-edelman.org: Jason's steward tools for the agent cluster. Static pages only, served as Workers
// Static Assets with headers from public/_headers; no script runs on the server, and the pages send nothing
// anywhere. First tool: /keys/, which makes atproto recovery keys in the browser (Jason, 2026-11-20).
// Deploy: npx wrangler deploy -c admin/wrangler.jsonc
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "admin-jason-edelman-org",
  "compatibility_date": "2026-09-01",
  "account_id": "543fde7feabd0af945bfae926ceea7ad",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "admin.jason-edelman.org", "custom_domain": true }],
  "workers_dev": false
}
