{
  "lexicon": 1,
  "id": "org.jason-edelman.atlas.case",
  "defs": {
    "main": {
      "type": "record",
      "description": "A case study on the Atlas of Care: who does what to keep a place going, who pays, what came of it, and the source it rests on. The atlas's own case studies are records of this kind in its owner's repo; anyone else's live in their own repo.",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "atlas",
          "title",
          "place",
          "does",
          "mode",
          "domain",
          "lat",
          "lon",
          "sourceTitle",
          "sourceUrl",
          "createdAt"
        ],
        "properties": {
          "atlas": {
            "type": "string",
            "format": "did",
            "description": "The atlas this case study is for. The backlink index finds contributed case studies by this field."
          },
          "title": {
            "type": "string",
            "maxGraphemes": 100,
            "maxLength": 1000
          },
          "place": {
            "type": "string",
            "maxGraphemes": 160,
            "maxLength": 1600,
            "description": "The place, as the source names it; for a contributed case study, the name of the unit it was placed in."
          },
          "country": {
            "type": "string",
            "maxGraphemes": 80,
            "maxLength": 800
          },
          "who": {
            "type": "string",
            "maxGraphemes": 400,
            "maxLength": 4000,
            "description": "Who does the work."
          },
          "does": {
            "type": "string",
            "maxGraphemes": 400,
            "maxLength": 4000,
            "description": "What is done."
          },
          "pays": {
            "type": "string",
            "maxGraphemes": 400,
            "maxLength": 4000,
            "description": "Who pays, or that nobody does."
          },
          "cost": {
            "type": "string",
            "maxGraphemes": 300,
            "maxLength": 3000
          },
          "result": {
            "type": "string",
            "maxGraphemes": 900,
            "maxLength": 9000,
            "description": "The documented outcome, and who measured it."
          },
          "contested": {
            "type": "string",
            "maxGraphemes": 900,
            "maxLength": 9000,
            "description": "Published criticism or failure of the headline result."
          },
          "whenItStops": {
            "type": "string",
            "maxGraphemes": 600,
            "maxLength": 6000,
            "description": "What happened when it stopped or was cut."
          },
          "mode": {
            "type": "string",
            "knownValues": [
              "repeats",
              "turns"
            ],
            "description": "repeats: maintenance, it has to be done again. turns: leverage, a bounded act that changes what follows."
          },
          "modeReason": {
            "type": "string",
            "maxGraphemes": 500,
            "maxLength": 5000
          },
          "domain": {
            "type": "string",
            "knownValues": [
              "farming",
              "care",
              "commons",
              "kitchen",
              "wetland",
              "trees",
              "land",
              "species",
              "vector",
              "vaccine",
              "eradication",
              "abortion",
              "contraception",
              "birth",
              "repair"
            ]
          },
          "lat": {
            "type": "string",
            "maxLength": 12,
            "description": "Latitude as a decimal string."
          },
          "lon": {
            "type": "string",
            "maxLength": 12,
            "description": "Longitude as a decimal string."
          },
          "scope": {
            "type": "string",
            "knownValues": [
              "world",
              "us",
              "in",
              "eu"
            ],
            "description": "For a contributed case study: which of the atlas's maps its unit belongs to."
          },
          "unit": {
            "type": "string",
            "maxLength": 64,
            "description": "For a contributed case study: the unit's id on that map."
          },
          "quote": {
            "type": "string",
            "maxGraphemes": 300,
            "maxLength": 3000,
            "description": "Copied from the source."
          },
          "quoteSpeaker": {
            "type": "string",
            "maxGraphemes": 200,
            "maxLength": 2000
          },
          "sourceTitle": {
            "type": "string",
            "maxGraphemes": 300,
            "maxLength": 3000
          },
          "sourcePublisher": {
            "type": "string",
            "maxGraphemes": 200,
            "maxLength": 2000
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 400
          },
          "sourceDate": {
            "type": "string",
            "maxGraphemes": 80,
            "maxLength": 800
          },
          "notes": {
            "type": "string",
            "maxGraphemes": 900,
            "maxLength": 9000,
            "description": "What is uncertain or was not verified."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
