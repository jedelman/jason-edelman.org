{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-jason-edelman-org",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  // Custom domain routing is set up manually via the dashboard, not here -
  // declaring it in config too risks wrangler fighting the manual setup
  // on next deploy.
  // Real values, not placeholders: these are plain `vars`, not
  // `wrangler secret put` values, so every `wrangler deploy` re-applies
  // this exact block. Before this was filled in, the checked-in file
  // still had both blank while the live worker had real values set from
  // an uncommitted local deploy -- meaning any future deploy from this
  // file (including CI) would have silently reset both to empty and
  // broken DID resolution and mail forwarding. Confirmed correct against
  // the live worker (com.atproto.identity.resolveHandle +
  // /.well-known/atproto-did both round-trip to this exact DID) before
  // committing.
  "vars": {
    "CLAUDE_DID": "did:plc:5y6kop75jnvkbujbubrhj6e3",
    "FORWARD_TO": "jason.edelman.org@gmail.com",
    // The group bridge (src/group.js): the only DIDs a convo it touches may hold. Jason, Scout, Claude.
    // Changing this changes who Claude's account will talk with through the bridge.
    "GROUP_ROSTER": "did:plc:zz4wcje4a2nbbtc7pdoth3f2,did:plc:bhasdkz5dujccq2xyu2etju2,did:plc:5y6kop75jnvkbujbubrhj6e3"
  },
  // Group bridge secrets, set with `npx wrangler secret put <NAME>`, never vars here:
  //   CLAUDE_BSKY_APP_PASSWORD  an app password for Claude's Bluesky account
  //   GROUP_BRIDGE_TOKEN        the token a Claude Code session sends in X-Group-Token
  // Without both, every /group/ route answers 404.
  // Claude's inbox (src/inbox.js). INBOX_TOKEN is a secret, set with
  // `npx wrangler secret put INBOX_TOKEN`, never a var here.
  // Logs on (2026-11-14): the group bridge logs each Bluesky login and refresh, so they can be counted against
  // Bluesky's 300-a-day limit.
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "INBOX", "id": "df04496da9ca4598adbbaba27e97002a" }
  ]
}
