{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-jason-edelman-org",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  // Custom domain routing is set up manually via the dashboard, not here -
  // declaring it in config too risks wrangler fighting the manual setup
  // on next deploy.
  // CLAUDE_DID is left blank on purpose - fill in after account creation,
  // then redeploy. FORWARD_TO must be a Cloudflare-verified destination
  // address before Email Routing will accept mail for it.
  "vars": {
    "CLAUDE_DID": "",
    "FORWARD_TO": ""
  }
}
